{
  "bin": {
    "ferrlabs-mcp": "./dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.3.6"
  },
  "description": "Model Context Protocol server for the FerrLabs ecosystem (FerrFlow, FerrVault, FerrTrack, FerrGrowth, FerrFleet, FerrLens)",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}": "prettier --write"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "ferrlabs",
    "ferrflow",
    "ferrvault",
    "ferrtrack",
    "ferrgrowth",
    "ferrfleet",
    "ferrlens",
    "model-context-protocol",
    "ai"
  ],
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "name": "@ferrlabs/mcp",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FerrLabs/MCP.git"
  },
  "scripts": {
    "build": "tsc",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "5.2.2"
}

{
  "name": "@ferrlabs/mcp-monorepo",
  "private": true,
  "version": "10.14.4",
  "description": "FerrLabs MCP servers: workspace root",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}": "prettier --write"
  },
  "scripts": {
    "build": "pnpm --filter @ferrlabs/mcp-core run build && pnpm --filter @ferrlabs/mcp run build",
    "ci:local": "pnpm build && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @ferrlabs/mcp-core run build && pnpm --filter @ferrlabs/mcp run typecheck"
  }
}

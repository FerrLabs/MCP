{
  "name": "@ferrlabs/mcp-monorepo",
  "private": true,
  "version": "10.14.3",
  "description": "FerrLabs MCP servers: workspace root",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}": "prettier --write"
  },
  "scripts": {
    "build": "pnpm --filter @ferrlabs/mcp-core run build && pnpm --filter @ferrlabs/mcp run build",
    "ci:local": "pnpm build && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @ferrlabs/mcp-core run build && pnpm --filter @ferrlabs/mcp run typecheck"
  }
}

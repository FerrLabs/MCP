{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "latestTag": "latest",
    "releaseCommitBody": "full",
    "tagTemplate": "v{version}"
  },
  "package": [
    {
      "name": "mcp",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "sharedPaths": [
        "packages/"
      ],
      "versionedFiles": [
        {
          "path": "package.json",
          "format": "json"
        },
        {
          "path": "packages/mcp-core/package.json",
          "format": "json"
        },
        {
          "path": "packages/mcp/package.json",
          "format": "json"
        },
        {
          "path": "packages/ferrvault-mcp/package.json",
          "format": "json"
        },
        {
          "path": "packages/ferrtrack-mcp/package.json",
          "format": "json"
        },
        {
          "path": "packages/ferrgrowth-mcp/package.json",
          "format": "json"
        },
        {
          "path": "packages/ferrfleet-mcp/package.json",
          "format": "json"
        }
      ]
    }
  ]
}
